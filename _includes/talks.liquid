{% if site.talks != blank %}
  <div class="activity-list">
    {% assign talks_by_year = site.talks | sort: 'date' | reverse | group_by: 'year' %}
    {% for year_group in talks_by_year %}
      <section class="activity-year">
        <h3 class="activity-year-label">{{ year_group.name }}</h3>
        <ul class="activity-items">
          {% for item in year_group.items %}
            <li class="activity-item">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
{% else %}
  <p>No talks so far...</p>
{% endif %}
