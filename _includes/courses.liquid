{% comment %}
  Teaching entries with an `instructor` (the student) are thesis advising entries,
  all others are courses -- the same split bin/generate_cv.py uses for the PDF CV.
  Pass kind="advising" or kind="courses".
{% endcomment %}
{% if include.kind == 'advising' %}
  {% assign entries = site.teachings | where_exp: 'item', 'item.instructor != nil' %}
{% else %}
  {% assign entries = site.teachings | where_exp: 'item', 'item.instructor == nil' %}
{% endif %}

{% if entries != empty %}
  <div class="activity-list">
    {% assign entries_by_year = entries | sort: 'year' | reverse | group_by: 'year' %}
    {% for year_group in entries_by_year %}
      <section class="activity-year">
        <h3 class="activity-year-label">{{ year_group.name }}</h3>
        <ul class="activity-items">
          {% for item in year_group.items %}
            <li class="activity-item">
              {% if include.kind == 'advising' %}
                {% assign title_parts = item.title | split: '"' %}
                {% if title_parts.size > 1 %}
                  {% assign thesis_title = title_parts[1] %}
                {% else %}
                  {% assign thesis_title = item.title %}
                {% endif %}
                <strong>{{ item.instructor }}</strong>
                {% if item.title contains 'Master Thesis' %}(MSc thesis){% elsif item.title contains 'Bachelor Thesis' %}(BSc thesis){% endif %}
                <br>
                <a href="{{ item.url | relative_url }}"><em>{{ thesis_title }}</em></a>
              {% else %}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
              {% if item.description %}
                <div class="activity-meta">{{ item.description | markdownify | remove: '<p>' | remove: '</p>' }}</div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
{% endif %}
