{% if site.outreach != blank %}
  <div class="activity-list">
    {% assign outreach_by_year = site.outreach | sort: 'year' | reverse | group_by: 'year' %}
    {% for year_group in outreach_by_year %}
      <section class="activity-year">
        <h3 class="activity-year-label">{{ year_group.name }}</h3>
        <ul class="activity-items">
          {% for item in year_group.items %}
            <li class="activity-item">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% if item.description %}
                  <div class="activity-meta">{{ item.description | markdownify | remove: '<p>' | remove: '</p>' }}</div>
                {% endif %}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
{% else %}
  <p>No outreach activities available yet.</p>
{% endif %}
